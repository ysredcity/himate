{
  "name": "himate-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @himate/desktop-web --",
    "build": "npm run build --workspace @himate/desktop-web",
    "lint": "npm run lint --workspace @himate/desktop-web",
    "check:governance": "node scripts/governance/check.mjs",
    "check:scripts": "npm run check:scripts --workspace @himate/desktop-web",
    "check:tokens": "npm run check:tokens --workspace @himate/desktop-web",
    "gate": "npm run check:governance && npm run gate --workspace @himate/desktop-web",
    "preview": "npm run preview --workspace @himate/desktop-web --"
  }
}
